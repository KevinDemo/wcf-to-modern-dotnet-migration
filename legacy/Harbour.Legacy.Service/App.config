<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <services>
      <service name="Harbour.Legacy.Service.ConsignmentService" behaviorConfiguration="withMetadata">
        <host>
          <baseAddresses>
            <!-- Temporary_Listen_Addresses is reserved for all users on Windows, so this runs without admin rights. -->
            <add baseAddress="http://localhost:80/Temporary_Listen_Addresses/Harbour/ConsignmentService.svc" />
          </baseAddresses>
        </host>
        <endpoint address="" binding="basicHttpBinding" contract="Harbour.Legacy.Service.IConsignmentService" />
      </service>
    </services>
    <behaviors>
      <serviceBehaviors>
        <behavior name="withMetadata">
          <serviceMetadata httpGetEnabled="true" />
          <serviceDebug includeExceptionDetailInFaults="false" />
        </behavior>
      </serviceBehaviors>
    </behaviors>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
