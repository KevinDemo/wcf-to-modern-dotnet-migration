<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <client>
      <!-- Cutover for a client means changing this address and nothing else. -->
      <endpoint name="ConsignmentService"
                address="http://localhost:80/Temporary_Listen_Addresses/Harbour/ConsignmentService.svc"
                binding="basicHttpBinding"
                contract="Harbour.Legacy.Client.IConsignmentService" />
    </client>
  </system.serviceModel>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
